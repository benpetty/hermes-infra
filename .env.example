# Copy to `.env` and fill in. The Makefile sources this file before tofu runs.
# OpenTofu auto-reads any env var prefixed `TF_VAR_` as a variable, so the
# names below correspond 1:1 to declarations in terraform/variables.tf.

# --- Hetzner Cloud --------------------------------------------------------
# Console: https://console.hetzner.cloud → Project → Security → API Tokens
# Permissions: Read & Write
TF_VAR_hcloud_token=

# --- Tailscale ------------------------------------------------------------
# Generate at: https://login.tailscale.com/admin/settings/keys
# Recommended settings:
#   - One-time use (uncheck "Reusable")
#   - Non-ephemeral (we want the box to stay registered across reboots)
#   - Pre-approved (skip the manual approval step)
#   - Expiry: short (90 days fine; rotate then)
TF_VAR_tailscale_auth_key=

# --- OpenRouter (default model provider for Hermes) ----------------------
# https://openrouter.ai/keys
TF_VAR_openrouter_api_key=

# --- Optional: emergency public SSH key -----------------------------------
# Tailscale SSH is the primary access path. Leave this blank unless you want
# to also enable a public-port-22 fallback (you'd also need to open the
# firewall rule, which is NOT enabled by default).
TF_VAR_ssh_admin_key=
